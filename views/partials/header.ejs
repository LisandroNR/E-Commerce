<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Camisetas FC - Ecommerce</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="top-header">
            <div class="logo-container">
                <a href="/">
                    <img src="/images/milogo.png" alt="Camisetas FC Logo">
                </a>
            </div>

            <div class="search-bar">
                <input type="search" placeholder="Buscar tu camiseta..." aria-label="Buscador">
                <button type="button"><i class="fas fa-search"></i></button>
            </div>

            <div class="user-actions">
                <a href="/">Inicio</a>
                <a href="/product">Productos</a>
                <a href="/cart" style="position: relative; display: inline-flex; align-items: center; text-decoration: none; margin-right: 15px; color: inherit; font-weight: bold;">
    
    🛒 Carrito
    
    <span style="background-color: #ff4444; color: white; border-radius: 50%; padding: 2px 6px; font-size: 12px; font-weight: bold; position: absolute; top: -8px; right: -12px;">
        <%= cartItemCount %>
    </span>
    
</a>
                <a href="/login"><i class="fas fa-user"></i> Ingresar</a>
                <a href="/register">Regístrate</a>
            </div>
        </div>

        <nav class="category-nav-container">
            <div class="category-nav-bar">
                <a href="/products?category=liga-argentina" class="category-item">
                    <span class="category-icon"><i class="fas fa-shield-halved"></i></span>
                    <span class="category-text">Liga Argentina</span>
                </a>
                <div class="separator"></div>

                <a href="/products?category=europa" class="category-item">
                    <span class="category-icon"><i class="fas fa-globe-europe"></i></span>
                    <span class="category-text">Europa</span>
                </a>
                <div class="separator"></div>

                <a href="/products?category=selecciones" class="category-item">
                    <span class="category-icon"><i class="fas fa-trophy"></i></span>
                    <span class="category-text">Selecciones</span>
                </a>
                <div class="separator"></div>

                <a href="/products?category=idolos" class="category-item">
                    <span class="category-icon"><i class="fas fa-star"></i></span>
                    <span class="category-text">Ediciones Ídolos</span>
                </a>
                <div class="separator"></div>

                <a href="/products?category=retro" class="category-item">
                    <span class="category-icon"><i class="fas fa-history"></i></span>
                    <span class="category-text">Clásicas/Retro</span>
                </a>
                <div class="separator"></div>

                <a href="/products?category=camperas" class="category-item">
                    <span class="category-icon"><i class="fas fa-vest"></i></span>
                    <span class="category-text">Camperas</span>
                </a>
                <div class="separator"></div>

                <a href="/products?category=shorts" class="category-item">
                    <span class="category-icon"><i class="fas fa-person-running"></i></span>
                    <span class="category-text">Shorts</span>
                </a>
                <div class="separator"></div>

                <a href="/products?category=entrenamiento" class="category-item">
                    <span class="category-icon"><i class="fas fa-tshirt"></i></span>
                    <span class="category-text">Entrenamiento</span>
                </a>
            </div>
        </nav>
    </header>