<%- include('../partials/header') %>

<main style="padding: 50px 5%; min-height: 60vh;">
    <div class="form-box">
        <h2 style="text-align: center; margin-bottom: 20px;">Crear Cuenta</h2>
        
        <form id="registerForm" action="/register" method="POST">
            
            <div class="form-group">
                <input type="text" id="nombre" name="nombre" placeholder="Tu nombre">
                <span id="errorNombre" style="color: red; font-size: 12px; display: block; margin-top: 5px;"></span>
            </div>

            <div class="form-group">
                <input type="text" id="apellido" name="apellido" placeholder="Tu apellido">
                <span id="errorApellido" style="color: red; font-size: 12px; display: block; margin-top: 5px;"></span>
            </div>

            <div class="form-group">
                <input type="email" id="email" name="email" placeholder="Correo electrónico">
                <span id="errorEmail" style="color: red; font-size: 12px; display: block; margin-top: 5px;"></span>
            </div>

            <div class="form-group">
                <input type="password" id="password" name="password" placeholder="Contraseña">
                <span id="errorPassword" style="color: red; font-size: 12px; display: block; margin-top: 5px;"></span>
            </div>

            <button type="submit" class="btn-main">Registrarme</button>
        </form>
        
        <p style="margin-top: 20px; text-align: center; font-size: 14px;">
            ¿Ya tenés una cuenta? <a href="/login" style="color: #00ceb0; font-weight: bold; text-decoration: none;">Iniciá sesión</a>
        </p>
    </div>
</main>

<%- include('../partials/footer') %>

<script src="/js/registerValidation.js"></script>