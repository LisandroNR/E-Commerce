<%- include('../partials/header') %>

<main style="padding: 50px 5%; min-height: 60vh;">
    <div class="form-box">
        <h2 style="text-align: center; margin-bottom: 20px;">Crear Cuenta</h2>
        <form action="/" method="GET">
            <div class="form-group">
                <input type="text" placeholder="Nombre completo" required>
            </div>
            <div class="form-group">
                <input type="email" placeholder="Correo electrónico" required>
            </div>
            <div class="form-group">
                <input type="password" placeholder="Contraseña" required>
            </div>
            <div class="form-group">
                <input type="password" placeholder="Confirmar contraseña" required>
            </div>
            <button type="submit" class="btn-main">Registrarme</button>
        </form>
        <p style="margin-top: 20px; text-align: center; font-size: 14px;">
            ¿Ya tenés una cuenta? <a href="/login" style="color: #00ceb0; font-weight: bold; text-decoration: none;">Iniciá sesión</a>
        </p>
    </div>
</main>

<%- include('../partials/footer') %>