<main style="padding: 50px 5%; min-height: 60vh;">
    <h1 style="text-align: center; margin-bottom: 30px;">Tu Carrito de Compras</h1>

    <% if (cartItems.length === 0) { %>
        <div style="text-align: center; padding: 50px; background: #f9f9f9; border-radius: 10px;">
            <h2>Tu carrito está vacío 😔</h2>
            <p>¡Es un buen momento para comprarte una camiseta nueva!</p>
            <a href="/" style="display: inline-block; padding: 10px 20px; background: #00ceb0; color: #1a1a1a; text-decoration: none; border-radius: 5px; margin-top: 15px; font-weight: bold;">Ir a la tienda</a>
        </div>
    <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 15px;">
            <% cartItems.forEach(item => { %>
                <div style="display: flex; align-items: center; justify-content: space-between; border: 1px solid #ddd; padding: 15px; border-radius: 8px;">
                    <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 80px; border-radius: 5px;">
                    <div style="flex: 1; margin-left: 20px;">
                        <h3><%= item.name %></h3>
                        <p>Precio Unitario: $<%= item.price %></p>
                        <p><strong>Subtotal: $<%= item.subtotal %></strong></p>
                    </div>

                    <form action="/cart/update" method="POST" style="display: flex; gap: 10px; align-items: center;">
                        <input type="hidden" name="productId" value="<%= item.id %>">
                        <button type="submit" name="action" value="decrease" style="padding: 5px 15px; cursor: pointer;">-</button>
                        <span><%= item.quantity %></span>
                        <button type="submit" name="action" value="increase" style="padding: 5px 15px; cursor: pointer;">+</button>
                    </form>
                </div>
            <% }) %>

            <div style="text-align: right; margin-top: 20px; font-size: 24px;">
                <strong>TOTAL: $<%= total %></strong>
            </div>

            <div style="display: flex; justify-content: space-between; margin-top: 20px;">
                <form action="/cart/empty" method="POST">
                    <button type="submit" style="padding: 10px 20px; background: #ff4d4d; color: white; border: none; border-radius: 5px; cursor: pointer;">Vaciar Carrito</button>
                </form>
                <a href="/checkout" style="padding: 10px 20px; background: #00ceb0; color: #1a1a1a; text-decoration: none; border-radius: 5px; font-weight: bold;">Ir a Pagar</a>
            </div>
        </div>
    <% } %>
</main>

