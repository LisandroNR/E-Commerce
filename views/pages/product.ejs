<main style="padding: 50px 5%; min-height: 70vh; background-color: #f4f4f4;">
    
    <div style="display: flex; flex-wrap: wrap; gap: 40px; background: white; padding: 40px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); max-width: 1000px; margin: 0 auto;">
        
        <div style="flex: 1; min-width: 300px; text-align: center;">
            <% 
                // Lógica inteligente para la imagen principal
                let rawImage = product.image ? product.image : 'https://via.placeholder.com/150/CCCCCC/000000?text=Sin+Imagen';
                let finalImage = rawImage;
                if (!rawImage.startsWith('http')) {
                    let cleanPath = rawImage.replace(/^\/+/, '').replace(/^images\//, '').replace(/^\/+/, '');
                    finalImage = '/images/' + cleanPath;
                }
            %>
            <img src="<%= finalImage %>" alt="<%= product.name %>" style="width: 100%; object-fit: contain;">
        </div>

        <div style="flex: 1; min-width: 300px; display: flex; flex-direction: column; justify-content: center;">
            
            <span style="color: #666; text-transform: uppercase; font-size: 14px; letter-spacing: 1px; font-weight: bold;">
                <%= product.category || 'Sin categoría' %>
            </span>
            
            <h1 style="font-size: 32px; color: #1a1a1a; margin: 10px 0;">
                <%= product.name %>
            </h1>
            
            <p style="color: #00ceb0; font-size: 36px; font-weight: bold; margin: 20px 0;">
                $<%= product.price %>
            </p>
            
            <p style="color: #444; font-size: 16px; line-height: 1.6; margin-bottom: 30px;">
                <%= product.description || 'Este producto aún no tiene una descripción detallada. ¡Pero te aseguramos que es de excelente calidad!' %>
            </p>

            <form action="/cart/add" method="POST" style="margin-top: auto;">
                <input type="hidden" name="productId" value="<%= product.id %>">
                <button type="submit" style="width: 100%; max-width: 300px; padding: 15px; background: #00ceb0; color: #1a1a1a; border: none; font-size: 18px; font-weight: bold; border-radius: 5px; cursor: pointer; transition: 0.3s; text-transform: uppercase;">
                    🛒 Agregar al carrito
                </button>
            </form>

        </div>
    </div>

    <section style="margin-top: 50px;">
        <h3 style="border-left: 4px solid #00ceb0; padding-left: 10px; margin-bottom: 20px; color: #333;">Productos relacionados</h3>
        
        <div style="display: flex; flex-wrap: wrap; gap: 25px;">
            <% if (relatedProducts && relatedProducts.length > 0) { %>
                <% relatedProducts.forEach(product => { 
                    // Lógica inteligente para los productos relacionados
                    let rawRelImage = product.image ? product.image : 'https://via.placeholder.com/150/CCCCCC/000000?text=Sin+Imagen';
                    let finalRelImage = rawRelImage;
                    if (!rawRelImage.startsWith('http')) {
                        let cleanRelPath = rawRelImage.replace(/^\/+/, '').replace(/^images\//, '').replace(/^\/+/, '');
                        finalRelImage = '/images/' + cleanRelPath;
                    }
                %>
                    <article style="width: 250px; background: white; padding: 15px; border-radius: 10px; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.08); transition: transform 0.2s;">
                        <a href="/product/<%= product.id %>" style="text-decoration: none; color: inherit;">
                            <!-- Contenedor fijo para que todas las fotos queden parejas -->
                            <div style="width: 100%; height: 220px; display: flex; align-items: center; justify-content: center; margin-bottom: 15px; border-radius: 8px; overflow: hidden; background-color: #fcfcfc;">
                                <img src="<%= finalRelImage %>" alt="<%= product.name %>" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                            </div>
                            <h4 style="font-size: 16px; margin: 0 0 10px; color: #333;"><%= product.name %></h4>
                            <p style="color: #00ceb0; font-weight: bold; font-size: 18px; margin: 0;">$<%= product.price %></p>
                        </a>
                    </article>
                <% }) %>
            <% } else { %>
                <p style="color: #666;">No hay productos relacionados por el momento.</p>
            <% } %>
        </div>
    </section>
</main>